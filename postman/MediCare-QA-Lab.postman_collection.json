          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test(\"patient code format\", () => pm.expect(b.patient_code).to.match(/^P-\\d+$/));",
                  "pm.collectionVariables.set(\"patient_id\", b.id);",
                  "pm.collectionVariables.set(\"patient_updated_at\", b.updated_at);",
                  "pm.test(\"has X-Request-ID header\", () => pm.response.to.have.header(\"X-Request-ID\"));",
                  "pm.test(\"responds in under 1500 ms\", () => pm.expect(pm.response.responseTime).to.be.below(1500));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"unique_last\", \"Test\" + Array.from({length:8},()=>\"abcdefghijklmnopqrstuvwxyz\"[Math.floor(Math.random()*26)]).join(\"\"));"
                ]
              }
            }
          ]

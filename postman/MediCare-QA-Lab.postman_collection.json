    {
      "name": "3. Prescriptions & refills",
      "item": [
        {
          "name": "Create prescription",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{pharmacist_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/prescriptions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "prescriptions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patient_id\": \"{{patient_id}}\",\n  \"medication_id\": 8,\n  \"prescriber_name\": \"Dr. Postman Fictional\",\n  \"dosage_instructions\": \"1 tablet once daily\",\n  \"quantity\": 30,\n  \"refills_authorized\": 2,\n  \"start_date\": \"2026-11-01\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201\", () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test(\"remaining = authorized\", () => pm.expect(b.refills_remaining).to.eql(b.refills_authorized));",
                  "pm.collectionVariables.set(\"rx_id\", b.id);",
                  "pm.test(\"has X-Request-ID header\", () => pm.response.to.have.header(\"X-Request-ID\"));",
                  "pm.test(\"responds in under 1500 ms\", () => pm.expect(pm.response.responseTime).to.be.below(1500));"
                ]
              }
            }
          ]
        },

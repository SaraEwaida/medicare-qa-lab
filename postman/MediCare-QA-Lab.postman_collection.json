    {
      "name": "2. Patients",
      "item": [
        {
          "name": "Search patients",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{pharmacist_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/patients?q=turner&page_size=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "patients"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "turner"
                },
                {
                  "key": "page_size",
                  "value": "5"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"paginated envelope\", () => pm.expect(b).to.have.keys(\"items\",\"total\",\"page\",\"page_size\"));",
                  "pm.test(\"every result matches\", () => b.items.forEach(p => pm.expect((p.first_name+\" \"+p.last_name).toLowerCase()).to.include(\"turner\")));",
                  "pm.test(\"has X-Request-ID header\", () => pm.response.to.have.header(\"X-Request-ID\"));",
                  "pm.test(\"responds in under 1500 ms\", () => pm.expect(pm.response.responseTime).to.be.below(1500));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create patient",

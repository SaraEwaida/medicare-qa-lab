              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Postman\",\n  \"last_name\": \"{{unique_last}}\",\n  \"date_of_birth\": \"1988-08-08\",\n  \"phone\": \"+970 59 222 3333\",\n  \"email\": \"postman.patient@example.com\"\n}"
            }

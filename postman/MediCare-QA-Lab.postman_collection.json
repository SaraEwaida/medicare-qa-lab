{
  "info": {
    "_postman_id": "00000000-0000-0000-0000-0000013528ee",
    "name": "MediCare QA Lab API",
    "description": "End-to-end API checks for MediCare QA Lab (synthetic data). Run in order: requests chain IDs through collection variables.\n\nnpx newman run postman/MediCare-QA-Lab.postman_collection.json -e postman/local.postman_environment.json",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Auth & system",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 and database ok\", () => { pm.response.to.have.status(200); pm.expect(pm.response.json().database).to.eql(\"ok\"); });",
                  "pm.test(\"has X-Request-ID header\", () => pm.response.to.have.header(\"X-Request-ID\"));",
                  "pm.test(\"responds in under 1500 ms\", () => pm.expect(pm.response.responseTime).to.be.below(1500));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as pharmacist",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"pharmacist@medicare.example.com\",\n  \"password\": \"{{demo_password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"returns bearer token\", () => { pm.expect(b.token_type).to.eql(\"bearer\"); pm.expect(b.access_token).to.be.a(\"string\"); });",
                  "pm.test(\"role is pharmacist\", () => pm.expect(b.user.email).to.include(\"pharmacist@\"));",
                  "pm.collectionVariables.set(\"pharmacist_token\", b.access_token);",
                  "pm.test(\"has X-Request-ID header\", () => pm.response.to.have.header(\"X-Request-ID\"));",
                  "pm.test(\"responds in under 1500 ms\", () => pm.expect(pm.response.responseTime).to.be.below(1500));"
                ]
              }
            }
          ]
        },
